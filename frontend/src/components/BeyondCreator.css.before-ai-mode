/* =========================================================
   BEYOND CREATOR V9.2 â€” ROBUST MIDDLE-MOUSE ORBIT FIX
========================================================= */

.creator-canvas-wrap,
.creator-canvas-wrap canvas {
  -webkit-user-select: none;
  user-select: none;
}

.creator-canvas-wrap canvas {
  cursor: grab;
}

.creator-canvas-wrap canvas:active {
  cursor: grabbing;
}


/* =========================================================
   BEYOND CREATOR V9.3 â€” TRUE MIDDLE-BUTTON ORBIT
========================================================= */

/* Do not show grabbing for ordinary left/right clicks.
   The JS controller changes the cursor to grabbing only while
   the physical middle mouse button is actually held. */
.creator-canvas-wrap canvas {
  cursor: grab;
}

.creator-canvas-wrap canvas:active {
  cursor: grab;
}


/* =========================================================
   BEYOND CREATOR V9.4 â€” EXACT 4-BUTTON VIEWPORT CONTROLS
========================================================= */

/* Ordinary left-click selection uses the normal cursor.
   JS switches to grabbing only for MIDDLE orbit and move for RIGHT pan. */
.creator-canvas-wrap canvas,
.creator-canvas-wrap canvas:active {
  cursor: default;
}

/* Avoid browser text/image selection around the WebGL viewport. */
.creator-canvas-wrap {
  -webkit-user-select: none;
  user-select: none;
}


/* =========================================================
   BEYOND CREATOR V9.5 â€” LEFT SELECT/ORBIT + MIDDLE PAN
========================================================= */

/*
  Exact viewport controls:
  - LEFT CLICK       = select
  - LEFT DRAG        = orbit
  - MIDDLE DRAG      = pan
  - WHEEL SCROLL     = zoom

  OrbitControls owns navigation again because its built-in pointer-state
  handling cleanly distinguishes a click from a drag. React Three Fiber
  continues receiving LEFT click events for object / mesh selection.
*/

.creator-canvas-wrap,
.creator-canvas-wrap canvas {
  -webkit-user-select: none;
  user-select: none;
}

.creator-canvas-wrap canvas,
.creator-canvas-wrap canvas:active {
  cursor: default;
}



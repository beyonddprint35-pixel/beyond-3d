  background: rgba(255, 255, 255, 0.006);
}

.creator-edit-inpanel__status.active {
  border-color: rgba(65, 167, 235, 0.38);
  background: rgba(31, 105, 160, 0.1);
}

.creator-edit-inpanel__status span {
  color: #5e7e95;
  font-size: 10px;
  font-weight: 800;
}

.creator-edit-inpanel__status strong {
  color: #92caeb;
  font-size: 11px;
  font-weight: 850;
}

.creator-edit-inpanel__step {
  min-height: 42px;
  padding: 0 9px;
  border: 1px solid rgba(101, 145, 181, 0.1);
  border-radius: 8px;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.007);
}

.creator-edit-inpanel__step > span,
.creator-edit-inpanel__fields label > span {
  color: #58778e;
  font-size: 10px;
  font-weight: 800;
}

.creator-edit-inpanel__step input,
.creator-edit-inpanel__fields input {
  min-width: 0;
  width: 100%;
  border: 0;
  outline: 0;
  color: #d6e8f3;
  background: transparent;
  font: inherit;
  font-size: 12px;
  font-weight: 800;
}

.creator-edit-inpanel__step small,
.creator-edit-inpanel__fields small {
  color: #55748b;
  font-size: 10px;
  font-weight: 800;
}

.creator-edit-inpanel__nudge {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6px;
}

.creator-edit-inpanel__nudge button,
.creator-edit-inpanel__actions button {
  min-height: 37px;
  border: 1px solid rgba(101, 145, 181, 0.11);
  border-radius: 7px;
  color: #7d9db3;
  background: rgba(255, 255, 255, 0.008);
  font: inherit;
  font-size: 11px;
  font-weight: 850;
  cursor: pointer;
}

.creator-edit-inpanel__nudge button:hover:not(:disabled),
.creator-edit-inpanel__actions button:hover:not(:disabled) {
  color: #e2f2fb;
  border-color: rgba(68, 160, 223, 0.33);
  background: rgba(35, 103, 156, 0.1);
}

.creator-edit-inpanel__nudge button:disabled,
.creator-edit-inpanel__actions button:disabled,
.creator-edit-inpanel__primary:disabled,
.creator-edit-inpanel__grid button:disabled {
  opacity: 0.32;
  cursor: not-allowed;
}

.creator-edit-inpanel__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 7px;
}

.creator-edit-inpanel__fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 7px;
}

.creator-edit-inpanel__fields label {
  min-height: 55px;
  padding: 7px 9px;
  border: 1px solid rgba(101, 145, 181, 0.1);
  border-radius: 8px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  grid-template-rows: auto auto;
  align-items: center;
  gap: 3px;
  background: rgba(255, 255, 255, 0.007);
}

.creator-edit-inpanel__fields label > span {
  grid-column: 1 / -1;
}

.creator-edit-inpanel__primary {
  width: 100%;
  min-height: 43px;
  border: 1px solid rgba(65, 164, 231, 0.38);
  border-radius: 8px;
  color: #e7f5fd;
  background: linear-gradient(
    135deg,
    rgba(33, 120, 183, 0.25),
    rgba(18, 65, 99, 0.14)
  );
  font: inherit;
  font-size: 11px;
  font-weight: 850;
  cursor: pointer;
}

.creator-edit-inpanel__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 7px;
}

.creator-edit-inpanel__grid button {
  min-height: 49px;
  padding: 8px;
  border: 1px solid rgba(101, 145, 181, 0.1);
  border-radius: 8px;
  display: grid;
  align-content: center;
  gap: 3px;
  color: #7898ae;
  background: rgba(255, 255, 255, 0.008);
  text-align: left;
  font: inherit;
  cursor: pointer;
}

.creator-edit-inpanel__grid strong {
  font-size: 11px;
  font-weight: 850;
}

.creator-edit-inpanel__grid small {
  color: #537189;
  font-size: 10px;
  font-weight: 750;
}

.creator-edit-inpanel__range {
  padding: 9px;
  border: 1px solid rgba(101, 145, 181, 0.09);
  border-radius: 8px;
  display: grid;
  gap: 7px;
  background: rgba(255, 255, 255, 0.006);
}

.creator-edit-inpanel__range > span {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  color: #58778e;
  font-size: 10px;
  font-weight: 800;
}

.creator-edit-inpanel__range > span strong {
  color: #91c0dc;
}

.creator-edit-inpanel__range input {
  width: 100%;
}

/*
  Critical fix: the visible Edit flyout must be allowed to expand.
  Earlier CSS was effectively clipping everything below FACE.
*/
.creator-studio-direct-flyout {
  height: auto !important;
  max-height: calc(100% - 18px) !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  scrollbar-width: thin;
  scrollbar-color: rgba(83, 145, 190, 0.38) transparent;
}

.creator-studio-direct-flyout::-webkit-scrollbar {
  width: 6px;
}

.creator-studio-direct-flyout::-webkit-scrollbar-track {
  background: transparent !important;
}

.creator-studio-direct-flyout::-webkit-scrollbar-thumb {
  border-radius: 999px;
  background: rgba(83, 145, 190, 0.36);
}

  min-height: 46px;
  padding:
    0 11px;
  border:
    1px solid
    rgba(89, 151, 196, 0.15);
  border-radius: 8px;
  display: grid;
  grid-template-columns:
    18px minmax(0, 1fr) auto 16px;
  align-items: center;
  gap: 9px;
  color: #b7d1e1;
  background:
    rgba(255, 255, 255, 0.009);
  cursor: pointer;
  list-style: none;
  user-select: none;
}


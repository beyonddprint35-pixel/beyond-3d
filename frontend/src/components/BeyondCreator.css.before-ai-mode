/* =========================================================
   BEYOND CREATOR â€” ARCHITECTURE V1.4
   SELECTED-OBJECT ORBIT + SWATCH DROPDOWN
========================================================= */

/*
  Navigation remains the V9.5 mapping:
  LEFT CLICK      = select
  LEFT DRAG       = orbit
  MIDDLE DRAG     = pan
  WHEEL           = zoom

  V1.4 changes only the ORBIT TARGET:
  - selected object -> orbit around its actual world-space bounding-box center
  - no selected object -> orbit around the visible model center
  This prevents the camera from rotating around the build plate / scene origin.
*/

.creator-appearance-picker {
  position: relative;
  margin-top: 9px;
}

.creator-appearance-picker-label {
  display: block;
  margin-bottom: 6px;
  color: #587890;

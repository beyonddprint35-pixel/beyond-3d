.beyond-creator {
  position: relative;
  padding:
    120px
    clamp(24px, 5vw, 82px);
  overflow: hidden;
  color: #dfeaf4;
  background:
    radial-gradient(
      circle at 66% 40%,
      rgba(33, 90, 140, 0.13),
      transparent 34%
    ),
    linear-gradient(
      180deg,
      rgba(4, 10, 17, 0.98),
      rgba(5, 13, 23, 0.99)
    );
  border-top:
    1px solid
    rgba(113, 158, 196, 0.08);
  border-bottom:
    1px solid
    rgba(113, 158, 196, 0.08);
}

.beyond-creator::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.16;
  background-image:
    linear-gradient(
      rgba(87, 137, 180, 0.06) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(87, 137, 180, 0.06) 1px,
      transparent 1px
    );
  background-size: 44px 44px;
  mask-image:
    linear-gradient(
      to bottom,
      transparent,
      #000 22%,
      #000 78%,
      transparent
    );
}

.creator-side-label {
  position: absolute;
  left: 18px;
  top: 122px;
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  color:
    rgba(92, 135, 172, 0.4);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.24em;
}

.creator-heading {
  position: relative;
  z-index: 2;
  max-width: 1400px;
  margin: 0 auto 52px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 50px;
}

.creator-index {
  margin-bottom: 18px;
  color: #5f86a7;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.2em;
}

.creator-heading h2 {
  margin: 0;
  color: #f0f6fb;
  font-size:
    clamp(46px, 6vw, 88px);
  line-height: 0.9;
  font-weight: 700;
  letter-spacing: -0.055em;
}

.creator-heading h2 span {
  color: #5e91bc;
}

.creator-heading > p {
  width:
    min(100%, 420px);
  margin: 0 0 4px;
  color: #7890a5;
  font-size: 15px;
  line-height: 1.7;
}

.creator-shell {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1400px;
  min-height: 690px;
  margin: 0 auto;
  display: grid;
  grid-template-columns:
    260px
    minmax(0, 1fr)
    300px;
  border:
    1px solid
    rgba(103, 149, 188, 0.14);
  border-radius: 18px;
  overflow: hidden;
  background:
    rgba(3, 9, 16, 0.76);
  box-shadow:
    0 35px 90px
    rgba(0, 0, 0, 0.24);
}

.creator-library,
.creator-inspector {
  padding: 26px;
  background:
    linear-gradient(
      180deg,
      rgba(8, 18, 29, 0.96),
      rgba(4, 11, 19, 0.92)
    );
}

.creator-library {
  border-right:
    1px solid
    rgba(100, 148, 187, 0.11);
}

.creator-inspector {
  border-left:
    1px solid
    rgba(100, 148, 187, 0.11);
  display: flex;
  flex-direction: column;
}

.creator-panel-heading {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 15px;
  color: #7893aa;
  font-size: 9px;
  letter-spacing: 0.14em;
}

.creator-panel-heading > span {
  color: #2e6d9f;
}

.creator-panel-heading strong {
  font-size: inherit;
}

.creator-add-grid {
  display: grid;
  grid-template-columns:
    1fr 1fr;
  gap: 8px;
}

.creator-add-grid button {
  min-height: 72px;
  padding: 11px;
  border:
    1px solid
    rgba(115, 156, 192, 0.12);
  border-radius: 10px;
  display: grid;
  place-items: center;
  gap: 8px;
  color: #7890a6;
  background:
    rgba(255, 255, 255, 0.015);
  cursor: pointer;
  transition:
    color 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease,
    background 0.2s ease;
}

.creator-add-grid button:hover {
  color: #d4e8f7;
  border-color:
    rgba(70, 145, 205, 0.38);
  background:
    rgba(35, 101, 155, 0.08);
  transform:
    translateY(-2px);
}

.creator-add-grid button span {
  font-size: 9px;
  font-weight: 750;
}

.creator-add-grid .creator-add-text {
  color: #a9cce5;
  border-color:
    rgba(74, 144, 200, 0.25);
  background:
    rgba(37, 107, 163, 0.08);
}

.creator-object-limit {
  margin-top: 10px;
  display: flex;
  align-items: center;
  gap: 7px;
  color: #4c6c86;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.creator-divider {
  height: 1px;
  margin: 24px 0;
  background:
    rgba(114, 154, 188, 0.1);
}

.creator-object-list {
  max-height: 320px;
  display: grid;
  gap: 6px;
  overflow: auto;
  padding-right: 3px;
}

.creator-object-list::-webkit-scrollbar {
  width: 4px;
}

.creator-object-list::-webkit-scrollbar-thumb {
  border-radius: 999px;
  background:
    rgba(79, 127, 166, 0.24);
}

.creator-object-list button {
  min-height: 50px;
  padding: 9px 10px;
  border:
    1px solid
    rgba(105, 147, 182, 0.08);
  border-radius: 9px;
  display: grid;
  grid-template-columns:
    28px 1fr 7px;
  align-items: center;
  gap: 8px;
  text-align: left;
  color: #6c879e;
  background:
    rgba(255, 255, 255, 0.01);
  cursor: pointer;
}

.creator-object-list button.active {
  color: #d3e8f7;
  border-color:
    rgba(69, 144, 204, 0.34);
  background:
    rgba(35, 102, 156, 0.1);
}

.creator-object-index {
  color: #41617b;
  font-size: 8px;
  font-weight: 800;
}

.creator-object-name {
  min-width: 0;
  display: grid;
  gap: 3px;
}

.creator-object-name strong,
.creator-object-name small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.creator-object-name strong {
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.07em;
}

.creator-object-name small {
  color: #4b677e;
  font-size: 7px;
}

.creator-object-list button i {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background:
    rgba(88, 123, 151, 0.35);
}

.creator-object-list button.active i {
  background: #65a5d7;
  box-shadow:
    0 0 10px
    rgba(88, 164, 219, 0.45);
}

.creator-object-actions {
  margin-top: 12px;
  display: grid;
  grid-template-columns:
    1fr 1fr;
  gap: 7px;
}

.creator-object-actions button {
  min-height: 38px;
  border:
    1px solid
    rgba(106, 149, 184, 0.1);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: #69849b;
  background: transparent;
  font: inherit;
  font-size: 8px;
  font-weight: 750;
  cursor: pointer;
}

.creator-object-actions button.danger {
  color: #966c74;
}

.creator-object-actions button:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.creator-viewport {
  min-width: 0;
  display: grid;
  grid-template-rows:
    auto
    1fr
    auto;
  background:
    radial-gradient(
      circle at 50% 48%,
      rgba(28, 78, 119, 0.14),
      transparent 34%
    ),
    #030910;
}

.creator-viewport-top {
  min-height: 62px;
  padding: 0 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  border-bottom:
    1px solid
    rgba(101, 145, 181, 0.09);
  color: #607c94;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.creator-viewport-top > div {
  display: flex;
  align-items: center;
  gap: 9px;
}

.creator-live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #6da981;
  box-shadow:
    0 0 12px
    rgba(109, 169, 129, 0.5);
}

.creator-viewport-controls {
  min-width: 0;
}

.creator-viewport-controls > span {
  max-width: 170px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #45647d;
  font-size: 7px;
}

.creator-icon-button {
  padding: 8px 10px;
  border:
    1px solid
    rgba(105, 149, 185, 0.12);
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #617a91;
  background:
    rgba(255, 255, 255, 0.012);
  font: inherit;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.08em;
  cursor: pointer;
}

.creator-icon-button.active {
  color: #a9c9e3;
  border-color:
    rgba(61, 132, 191, 0.35);
  background:
    rgba(37, 103, 157, 0.1);
}

.creator-canvas-wrap {
  position: relative;
  min-height: 540px;
}

.creator-canvas-wrap canvas {
  display: block;
  width: 100% !important;
  height: 100% !important;
}

.creator-view-hint {
  position: absolute;
  left: 50%;
  bottom: 16px;
  transform:
    translateX(-50%);
  padding: 8px 11px;
  border:
    1px solid
    rgba(101, 148, 185, 0.1);
  border-radius: 999px;
  display: flex;
  align-items: center;
  gap: 7px;
  color: #537088;
  background:
    rgba(4, 11, 18, 0.72);
  backdrop-filter:
    blur(10px);
  font-size: 6px;
  font-weight: 800;
  letter-spacing: 0.1em;
  white-space: nowrap;
  pointer-events: none;
}

.creator-stats {
  min-height: 72px;
  display: grid;
  grid-template-columns:
    repeat(3, 1fr);
  border-top:
    1px solid
    rgba(102, 146, 182, 0.09);
}

.creator-stats > div {
  min-width: 0;
  padding: 15px 18px;
  display: grid;
  align-content: center;
  gap: 6px;
  border-right:
    1px solid
    rgba(102, 146, 182, 0.08);
}

.creator-stats > div:last-child {
  border-right: 0;
}

.creator-stats span,
.creator-stats strong {
  display: block;
}

.creator-stats span {
  color: #4e6b83;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.creator-stats strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9db7cd;
  font-size: 9px;
  font-weight: 650;
}

.creator-selected-name {
  display: block;
  margin-bottom: 18px;
  color: #d5e6f3;
  font-size: 14px;
  line-height: 1.2;
}

.creator-no-selection {
  margin: 0;
  color: #587189;
  font-size: 10px;
  line-height: 1.6;
}

.creator-inspector-block {
  padding: 16px 0;
  border-top:
    1px solid
    rgba(103, 146, 181, 0.08);
}

.creator-inspector-title {
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #69869e;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.creator-inspector-title span {
  color: #36546d;
  font-size: 7px;
}

.creator-text-field {
  display: grid;
  gap: 7px;
}

.creator-text-field > span {
  color: #5e7b93;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.creator-text-field input {
  width: 100%;
  height: 42px;
  padding: 0 11px;
  border:
    1px solid
    rgba(82, 143, 193, 0.22);
  border-radius: 9px;
  outline: 0;
  color: #dcecf8;
  background:
    rgba(28, 83, 127, 0.08);
  font: inherit;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.creator-field-note {
  display: block;
  margin-top: 7px;
  color: #3f5e77;
  font-size: 7px;
  line-height: 1.5;
}

.creator-vector-fields {
  display: grid;
  grid-template-columns:
    repeat(3, 1fr);
  gap: 7px;
}

.creator-vector-fields label {
  min-width: 0;
  height: 42px;
  padding: 0 8px;
  border:
    1px solid
    rgba(103, 147, 183, 0.1);
  border-radius: 8px;
  display: grid;
  grid-template-columns:
    14px 1fr;
  align-items: center;
  gap: 3px;
  background:
    rgba(255, 255, 255, 0.012);
}

.creator-vector-fields label > span {
  color: #44647e;
  font-size: 8px;
  font-weight: 800;
}

.creator-vector-fields input {
  min-width: 0;
  width: 100%;
  border: 0;
  outline: 0;
  color: #c3d5e4;
  background: transparent;
  font: inherit;
  font-size: 10px;
  font-weight: 700;
  text-align: right;
  appearance: textfield;
}

.creator-vector-fields input::-webkit-inner-spin-button,
.creator-vector-fields input::-webkit-outer-spin-button {
  appearance: none;
  margin: 0;
}

.creator-nudge-row {
  margin-top: 7px;
  display: grid;
  grid-template-columns:
    repeat(4, 1fr);
  gap: 5px;
}

.creator-nudge-row button {
  min-height: 30px;
  border:
    1px solid
    rgba(103, 147, 183, 0.08);
  border-radius: 7px;
  color: #547188;
  background:
    rgba(255, 255, 255, 0.01);
  font: inherit;
  font-size: 7px;
  cursor: pointer;
}

.creator-materials {
  display: grid;
  grid-template-columns:
    1fr 1fr;
  gap: 7px;
}

.creator-material {
  padding: 8px 9px;
  border:
    1px solid
    rgba(110, 151, 186, 0.1);
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 7px;
  color: #758da2;
  background:
    rgba(255, 255, 255, 0.012);
  cursor: pointer;
}

.creator-material i {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  box-shadow:
    0 0 0 2px
    rgba(255, 255, 255, 0.05);
}

.creator-material span {
  font-size: 7px;
  font-weight: 700;
}

.creator-material.active {
  color: #dcecff;
  border-color:
    rgba(76, 145, 202, 0.36);
  background:
    rgba(43, 111, 166, 0.1);
}

.creator-next-tools {
  margin-top: 8px;
  padding-top: 14px;
  display: grid;
  gap: 8px;
  border-top:
    1px solid
    rgba(103, 146, 181, 0.08);
}

.creator-next-tools > span {
  margin-bottom: 2px;
  color: #3f607b;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.creator-next-tools > div {
  padding: 8px 0;
  display: flex;
  justify-content: space-between;
  gap: 8px;
  border-bottom:
    1px solid
    rgba(103, 146, 181, 0.06);
}

.creator-next-tools strong {
  color: #6d879d;
  font-size: 8px;
}

.creator-next-tools small {
  color: #3c576d;
  font-size: 7px;
}

.creator-inspector-actions {
  margin-top: auto;
  padding-top: 18px;
}

.creator-primary-action {
  width: 100%;
  min-height: 46px;
  padding: 0 15px;
  border: 0;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: white;
  background:
    linear-gradient(
      135deg,
      #1e69dc,
      #4393f2
    );
  box-shadow:
    0 16px 34px
    rgba(18, 89, 184, 0.22);
  font: inherit;
  font-size: 9px;
  font-weight: 800;
  cursor: pointer;
}

.creator-reset-action {
  width: 100%;
  min-height: 40px;
  margin-top: 8px;
  border:
    1px solid
    rgba(110, 151, 187, 0.12);
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: #678198;
  background: transparent;
  font: inherit;
  font-size: 8px;
  font-weight: 750;
  cursor: pointer;
}

@media (max-width: 1180px) {
  .creator-shell {
    grid-template-columns:
      230px
      minmax(0, 1fr);
  }

  .creator-inspector {
    grid-column:
      1 / -1;
    border-left: 0;
    border-top:
      1px solid
      rgba(100, 148, 187, 0.11);
    display: grid;
    grid-template-columns:
      1fr 1.2fr 1.2fr;
    gap: 22px;
  }

  .creator-inspector-top {
    grid-column: 1;
  }

  .creator-inspector-block {
    border-top: 0;
    border-left:
      1px solid
      rgba(103, 146, 181, 0.08);
    padding:
      0 0 0 18px;
  }

  .creator-next-tools {
    display: none;
  }

  .creator-inspector-actions {
    grid-column:
      1 / -1;
    margin-top: 0;
    padding-top: 0;
    display: grid;
    grid-template-columns:
      220px 160px;
    gap: 8px;
  }

  .creator-reset-action {
    margin-top: 0;
  }
}

@media (max-width: 760px) {
  .beyond-creator {
    padding:
      82px 18px;
  }

  .creator-side-label {
    display: none;
  }

  .creator-heading {
    margin-bottom: 30px;
    display: block;
  }

  .creator-heading h2 {
    font-size:
      clamp(44px, 14vw, 64px);
  }

  .creator-heading > p {
    margin-top: 24px;
    font-size: 14px;
  }

  .creator-shell {
    display: block;
    border-radius: 14px;
  }

  .creator-library,
  .creator-inspector {
    padding: 20px;
  }

  .creator-library {
    border-right: 0;
    border-bottom:
      1px solid
      rgba(100, 148, 187, 0.11);
  }

  .creator-object-list {
    max-height: 210px;
  }

  .creator-canvas-wrap {
    min-height: 400px;
  }

  .creator-viewport-top {
    min-height: 54px;
    padding: 0 14px;
  }

  .creator-viewport-controls > span {
    display: none;
  }

  .creator-view-hint {
    max-width:
      calc(100% - 26px);
    white-space: normal;
    text-align: center;
    line-height: 1.5;
  }

  .creator-stats > div {
    padding:
      13px 10px;
  }

  .creator-inspector {
    display: block;
    border-left: 0;
  }

  .creator-inspector-block {
    padding: 15px 0;
    border-left: 0;
    border-top:
      1px solid
      rgba(103, 146, 181, 0.08);
  }

  .creator-next-tools {
    display: grid;
  }

  .creator-inspector-actions {
    display: block;
    padding-top: 18px;
  }

  .creator-reset-action {
    margin-top: 8px;
  }
}

@media (max-width: 430px) {
  .beyond-creator {
    padding:
      72px 14px;
  }

  .creator-library,
  .creator-inspector {
    padding: 17px;
  }

  .creator-add-grid {
    grid-template-columns:
      repeat(4, 1fr);
  }

  .creator-add-grid button {
    min-height: 64px;
    padding: 8px 3px;
  }

  .creator-add-grid button span {
    font-size: 7px;
  }

  .creator-object-actions {
    grid-template-columns:
      1fr 1fr;
  }

  .creator-canvas-wrap {
    min-height: 340px;
  }

  .creator-stats {
    grid-template-columns:
      1fr 1fr;
  }

  .creator-stats > div:nth-child(3) {
    display: none;
  }

  .creator-vector-fields {
    gap: 5px;
  }

  .creator-vector-fields label {
    padding: 0 6px;
  }

  .creator-nudge-row {
    grid-template-columns:
      1fr 1fr;
  }
}


/* =========================================================
   BEYOND CREATOR V3 â€” MULTI SELECT + BOOLEAN TOOLS
========================================================= */

.creator-multi-select-note {
  margin:
    -4px 0 10px;

  color: #38566f;

  font-size: 6px;
  font-weight: 800;

  letter-spacing:
    0.1em;

  line-height: 1.45;
}

.creator-role-dot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  justify-self: end;
}

.creator-role-dot.solid {
  background: #5c9acb;

  box-shadow:
    0 0 10px
    rgba(
      92,
      154,
      203,
      0.35
    );
}

.creator-role-dot.hole {
  background: #c26f7d;

  box-shadow:
    0 0 10px
    rgba(
      194,
      111,
      125,
      0.3
    );
}

.creator-boolean-panel {
  margin-top: 22px;

  padding-top: 20px;

  border-top:
    1px solid
    rgba(
      103,
      146,
      181,
      0.08
    );

  display: grid;


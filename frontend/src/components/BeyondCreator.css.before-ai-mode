/* ---------------------------------------------------------
   TRUE FULLSCREEN — DO NOT EXPAND LEFT RAIL
--------------------------------------------------------- */

/*
  !important is intentional here: legacy fullscreen Creator rules have
  higher specificity / inline layout values. Studio always owns this grid.
*/
.creator-shell.creator-studio-direct-layout {
  grid-template-columns:
    72px
    minmax(0, 1fr)
    !important;
}

/* Native Fullscreen API */
.creator-shell.creator-studio-direct-layout:fullscreen,
.creator-shell.creator-studio-direct-layout:-webkit-full-screen {
  width: 100vw !important;
  max-width: none !important;
  height: 100vh !important;
  min-height: 100vh !important;
  margin: 0 !important;
  border: 0 !important;
  border-radius: 0 !important;
  grid-template-columns:
    72px
    minmax(0, 1fr)
    !important;
  background: #030910 !important;
}

/*
  Also cover Creator fullscreen wrapper classes used by older versions.
*/
.creator-shell.creator-studio-direct-layout.creator-fullscreen,
.creator-shell.creator-studio-direct-layout.fullscreen,
.creator-shell.creator-studio-direct-layout.is-fullscreen {
  width: 100vw !important;
  max-width: none !important;
  height: 100vh !important;
  min-height: 100vh !important;
  grid-template-columns:
    72px
    minmax(0, 1fr)
    !important;
}

.creator-shell.creator-studio-direct-layout:fullscreen
.creator-studio-direct-rail,
.creator-shell.creator-studio-direct-layout:-webkit-full-screen
.creator-studio-direct-rail,
.creator-shell.creator-studio-direct-layout.creator-fullscreen
.creator-studio-direct-rail,
.creator-shell.creator-studio-direct-layout.fullscreen
.creator-studio-direct-rail,
.creator-shell.creator-studio-direct-layout.is-fullscreen
.creator-studio-direct-rail {
  grid-column: 1 !important;
  width: 72px !important;
  min-width: 72px !important;
  max-width: 72px !important;
  align-self: stretch !important;
}

.creator-shell.creator-studio-direct-layout:fullscreen
.creator-viewport,
.creator-shell.creator-studio-direct-layout:-webkit-full-screen
.creator-viewport,
.creator-shell.creator-studio-direct-layout.creator-fullscreen
.creator-viewport,
.creator-shell.creator-studio-direct-layout.fullscreen
.creator-viewport,
.creator-shell.creator-studio-direct-layout.is-fullscreen
.creator-viewport {
  grid-column: 2 !important;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;
  height: 100vh !important;
  min-height: 100vh !important;
  flex: 1 1 auto !important;
}

/*
  The right inspector must never reserve a fullscreen grid column.
  Its small project dock remains absolute/floating.
*/
.creator-shell.creator-studio-direct-layout:fullscreen
.creator-inspector,
.creator-shell.creator-studio-direct-layout:-webkit-full-screen
.creator-inspector,
.creator-shell.creator-studio-direct-layout.creator-fullscreen
.creator-inspector,
.creator-shell.creator-studio-direct-layout.fullscreen
.creator-inspector,
.creator-shell.creator-studio-direct-layout.is-fullscreen
.creator-inspector {
  position: absolute !important;
  right: 14px !important;
  bottom: 14px !important;
  top: auto !important;
  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;
}

/*
  Let flexbox assign all remaining fullscreen height to the actual Canvas.
*/

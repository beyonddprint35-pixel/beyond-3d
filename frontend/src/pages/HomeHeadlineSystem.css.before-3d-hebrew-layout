/* =========================================================
   BEYOND — FINAL HOMEPAGE HEADLINE SYSTEM

   Loaded LAST.
   One visual language across all major homepage headlines.
========================================================= */

.beyond-home {
  --beyond-headline-font:
    var(
      --font-display-family,
      "Space Grotesk",
      "Inter",
      sans-serif
    );

  --beyond-headline-white:
    #f5f8ff;

  --beyond-headline-blue:
    #609cff;

  --beyond-headline-weight:
    600;

  --beyond-headline-spacing:
    -0.067em;

  --beyond-headline-line:
    0.88;
}


/* =========================================================
   MAIN HERO HEADLINES
========================================================= */

.beyond-home .digital-menu-copy h1,
.beyond-home .digital-menu-title,
.beyond-home .hero-copy h1 {
  font-family:
    var(--beyond-headline-font) !important;

  font-weight:
    var(--beyond-headline-weight) !important;

  font-style:
    normal !important;

  line-height:
    var(--beyond-headline-line) !important;

  letter-spacing:
    var(--beyond-headline-spacing) !important;

  color:
    var(--beyond-headline-white) !important;

  -webkit-text-stroke:
    0 !important;

  text-shadow:
    none !important;
}


/* =========================================================
   ALL NORMAL HOMEPAGE SECTION HEADLINES
========================================================= */

.beyond-home .digital-benefits-heading h2,
.beyond-home .process-story-heading h2,
.beyond-home .creator-heading h2,
.beyond-home .community-heading h2,
.beyond-home .reviews-heading h2,
.beyond-home .start-project-heading h2,
.beyond-home .home-section-heading h2,
.beyond-home .home-final-cta h2,
.beyond-home .ai-studio-heading h2 {
  font-family:
    var(--beyond-headline-font) !important;

  font-size:
    clamp(
      56px,
      5.8vw,
      88px
    ) !important;

  font-weight:
    var(--beyond-headline-weight) !important;

  font-style:
    normal !important;

  line-height:
    var(--beyond-headline-line) !important;

  letter-spacing:
    var(--beyond-headline-spacing) !important;

  color:
    var(--beyond-headline-white) !important;

  -webkit-text-stroke:
    0 !important;

  text-shadow:
    none !important;
}


/* =========================================================
   SECOND / ACCENT PART OF EVERY HEADLINE
   ALWAYS BEYOND BLUE
========================================================= */

.beyond-home .digital-menu-copy h1 span,
.beyond-home .digital-menu-title span,
.beyond-home .hero-copy h1 span,

.beyond-home .digital-benefits-heading h2 span,
.beyond-home .process-story-heading h2 span,
.beyond-home .creator-heading h2 span,
.beyond-home .community-heading h2 span,
.beyond-home .reviews-heading h2 span,
.beyond-home .start-project-heading h2 span,
.beyond-home .home-section-heading h2 span,
.beyond-home .home-final-cta h2 span,
.beyond-home .ai-studio-heading h2 span {
  font-family:
    inherit !important;

  font-size:
    inherit !important;

  font-weight:
    inherit !important;

  line-height:
    inherit !important;

  letter-spacing:
    inherit !important;

  color:
    var(--beyond-headline-blue) !important;

  -webkit-text-fill-color:
    var(--beyond-headline-blue) !important;

  -webkit-text-stroke:
    0 !important;

  text-shadow:
    none !important;
}


/* =========================================================
   REMOVE OLD OUTLINED 3D HERO WORD
========================================================= */

.beyond-home .hero-copy h1 .outline,
.beyond-home .hero-copy h1 .outlined,
.beyond-home .hero-copy h1 .hero-outline,
.beyond-home .hero-copy h1 .outline-text,
.beyond-home .hero-copy h1 [class*="outline"] {
  color:
    var(--beyond-headline-blue) !important;

  -webkit-text-fill-color:
    var(--beyond-headline-blue) !important;

  -webkit-text-stroke:
    0 !important;

  text-shadow:
    none !important;
}


/* =========================================================
   LIGHT MODE
========================================================= */

html[data-beyond-theme="light"]
.beyond-home {
  --beyond-headline-white:
    #101827;

  --beyond-headline-blue:
    #2872cf;
}


/* =========================================================
   HEBREW
========================================================= */

html[data-beyond-language="he"]
.beyond-home :is(
  .digital-menu-copy h1,
  .digital-menu-title,
  .hero-copy h1,
  .digital-benefits-heading h2,
  .process-story-heading h2,
  .creator-heading h2,
  .community-heading h2,
  .reviews-heading h2,
  .start-project-heading h2,
  .home-section-heading h2,
  .home-final-cta h2,
  .ai-studio-heading h2
) {
  direction:
    rtl !important;

  text-align:
    right !important;

  letter-spacing:
    normal !important;

  unicode-bidi:
    plaintext !important;
}


html[data-beyond-language="he"]
.beyond-home :is(
  .digital-menu-copy h1,
  .digital-menu-title,
  .hero-copy h1,
  .digital-benefits-heading h2,
  .process-story-heading h2,
  .creator-heading h2,
  .community-heading h2,
  .reviews-heading h2,
  .start-project-heading h2,
  .home-section-heading h2,
  .home-final-cta h2,
  .ai-studio-heading h2
) span {
  letter-spacing:
    normal !important;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:700px) {

  .beyond-home .digital-benefits-heading h2,
  .beyond-home .process-story-heading h2,
  .beyond-home .creator-heading h2,
  .beyond-home .community-heading h2,
  .beyond-home .reviews-heading h2,
  .beyond-home .start-project-heading h2,
  .beyond-home .home-section-heading h2,
  .beyond-home .home-final-cta h2,
  .beyond-home .ai-studio-heading h2 {
    font-size:
      clamp(
        46px,
        12vw,
        66px
      ) !important;
  }

}


/* DIGITAL MENU HERO FIRST LINE WHITE */
.beyond-home .digital-menu-copy h1 > span:first-child,
.beyond-home .digital-menu-title > span:first-child,
.beyond-home .digital-menu-copy h1 > div:first-child,
.beyond-home .digital-menu-title > div:first-child {
  color: var(--beyond-headline-white) !important;
  -webkit-text-fill-color: var(--beyond-headline-white) !important;
  -webkit-text-stroke: 0 !important;
  text-shadow: none !important;
}

/* DIGITAL MENU HERO SECOND LINE BLUE */
.beyond-home .digital-menu-copy h1 > span:last-child,
.beyond-home .digital-menu-title > span:last-child,
.beyond-home .digital-menu-copy h1 > div:last-child,
.beyond-home .digital-menu-title > div:last-child {
  color: var(--beyond-headline-blue) !important;
  -webkit-text-fill-color: var(--beyond-headline-blue) !important;
  -webkit-text-stroke: 0 !important;
  text-shadow: none !important;
}


/* =========================================================
   HEBREW DIGITAL MENU TITLE — FINAL SIZE/FIT OVERRIDE
   Higher specificity than previous global headline rules.
========================================================= */

html[data-beyond-language="he"]
#root
.beyond-home
.digital-menu-title.is-hebrew {
  width: 100% !important;
  max-width: 100% !important;

  font-size:
    clamp(
      48px,
      4.6vw,
      78px
    ) !important;

  line-height:
    0.94 !important;

  direction: rtl !important;
  text-align: right !important;

  align-items: flex-end !important;

  overflow: visible !important;
}


html[data-beyond-language="he"]
#root
.beyond-home
.digital-menu-title.is-hebrew
.digital-menu-title-line {
  width: auto !important;
  max-width: 100% !important;

  white-space: nowrap !important;

  direction: rtl !important;
  text-align: right !important;

  margin: 0 !important;
}


/* First line */
html[data-beyond-language="he"]
#root
.beyond-home
.digital-menu-title.is-hebrew
.digital-menu-title-line-one {
  color: #f5f8ff !important;
  -webkit-text-fill-color: #f5f8ff !important;
}


/* Second line */
html[data-beyond-language="he"]
#root
.beyond-home
.digital-menu-title.is-hebrew
.digital-menu-title-line-two {
  color: #609cff !important;
  -webkit-text-fill-color: #609cff !important;
}


/* Tablet */
@media (max-width: 1100px) {
  html[data-beyond-language="he"]
  #root
  .beyond-home
  .digital-menu-title.is-hebrew {
    font-size:
      clamp(
        46px,
        6.3vw,
        68px
      ) !important;
  }
}


/* Mobile */
@media (max-width: 700px) {
  html[data-beyond-language="he"]
  #root
  .beyond-home
  .digital-menu-title.is-hebrew {
    font-size:
      clamp(
        38px,
        10vw,
        54px
      ) !important;
  }
}



/* =========================================================
   HEBREW DIGITAL MENU — MATCH 3D HERO SIZE
========================================================= */

html[data-beyond-language="he"]
#root
.beyond-home
.digital-menu-title.is-hebrew {
  font-size:
    var(--beyond-headline-hero-size) !important;

  line-height:
    var(--beyond-headline-line) !important;

  width: 100% !important;
  max-width: 100% !important;

  direction: rtl !important;
  text-align: right !important;

  align-items: flex-end !important;
}


/* Keep each sentence on one line */

html[data-beyond-language="he"]
#root
.beyond-home
.digital-menu-title.is-hebrew
.digital-menu-title-line {
  width: auto !important;
  max-width: 100% !important;

  white-space: nowrap !important;

  direction: rtl !important;
  text-align: right !important;
}


/* Mobile uses the same hero scale system too */

@media(max-width:700px) {

  html[data-beyond-language="he"]
  #root
  .beyond-home
  .digital-menu-title.is-hebrew {
    font-size:
      var(--beyond-headline-hero-size) !important;
  }

}


/* =========================================================
   HEBREW DIGITAL MENU — LARGE BUT FITS VIEW
========================================================= */

html[data-beyond-language="he"]
#root
.beyond-home
.digital-menu-title.is-hebrew {
  width: 100% !important;
  max-width: 100% !important;

  /*
    Keep the large hero feeling.
    Only slightly smaller than the English hero
    so the Hebrew sentence stays inside the view.
  */
  font-size:
    clamp(
      64px,
      5.4vw,
      92px
    ) !important;

  line-height:
    0.92 !important;

  direction:
    rtl !important;

  text-align:
    right !important;

  align-items:
    flex-end !important;
}


html[data-beyond-language="he"]
#root
.beyond-home
.digital-menu-title.is-hebrew
.digital-menu-title-line {
  display: block !important;

  width: auto !important;
  max-width: 100% !important;

  white-space:
    nowrap !important;

  margin:
    0 !important;

  direction:
    rtl !important;

  text-align:
    right !important;
}


/* Tablet only */

@media(max-width:1100px) {

  html[data-beyond-language="he"]
  #root
  .beyond-home
  .digital-menu-title.is-hebrew {
    font-size:
      clamp(
        58px,
        7vw,
        80px
      ) !important;
  }

}


/* Mobile only */

@media(max-width:700px) {

  html[data-beyond-language="he"]
  #root
  .beyond-home
  .digital-menu-title.is-hebrew {
    font-size:
      clamp(
        44px,
        11vw,
        62px
      ) !important;
  }

}


/* =========================================================
   DIGITAL MENU HERO — EXACT SAME SIZE AS 3D HERO
========================================================= */

/*
  Both hero headlines now use the exact same size variable.
*/

#root
.beyond-home
.digital-menu-title,

#root
.beyond-home
.hero-copy h1 {
  font-size:
    var(--beyond-headline-hero-size) !important;

  line-height:
    var(--beyond-headline-line) !important;
}


/* Hebrew Digital Menu:
   override the smaller Hebrew-specific rules added earlier.
*/

html[data-beyond-language="he"]
#root
.beyond-home
.digital-menu-title.is-hebrew {
  font-size:
    var(--beyond-headline-hero-size) !important;

  line-height:
    var(--beyond-headline-line) !important;

  direction:
    rtl !important;

  text-align:
    right !important;

  align-items:
    flex-end !important;
}


/* Same mobile scale for both heroes */

@media(max-width:700px) {

  #root
  .beyond-home
  .digital-menu-title,

  #root
  .beyond-home
  .hero-copy h1,

  html[data-beyond-language="he"]
  #root
  .beyond-home
  .digital-menu-title.is-hebrew {
    font-size:
      var(--beyond-headline-hero-size) !important;
  }

}

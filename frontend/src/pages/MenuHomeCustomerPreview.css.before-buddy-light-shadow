/* ==========================================================
   HOMEPAGE CUSTOMER MENU PREVIEW

   IMPORTANT:
   This uses the EXACT same phone + 390 × 844 screen
   structure as Menu Builder's Mobile View.

   We never scale the iframe/menu internally.
   We scale the entire physical phone as one object.
   ========================================================== */

.menu-home-exact-mobile-preview-host {
  position: relative;
  display: grid !important;
  place-items: center !important;
  width: 100% !important;
  max-width: 100% !important;
  min-height: 620px !important;
  overflow: visible !important;
}

/* Remove the older Figma phone. The exact Menu Builder phone
   rendered by MenuHomeCustomerPreview replaces it completely. */
.menu-home-exact-mobile-preview-host > .menu-home-figma-phone {
  display: none !important;
}

.menu-home-mobile-demo-stage {
  position: relative;
  width: 287px;
  height: 605px;
  max-width: 100%;
  flex: 0 0 auto;
}

/* MobileMenuPreview.css keeps this phone at exactly 410 × 864,
   with a 390 × 844 screen and iframe. Only the complete device
   is reduced to fit the landing-page composition. */
.menu-home-mobile-demo-phone {
  position: absolute !important;
  top: 0;
  left: 0;
  margin: 0 !important;
  transform: scale(.7);
  transform-origin: top left;
}

/* Keep the exact Menu Builder screen geometry untouched. */
.menu-home-mobile-demo-phone .mobile-menu-preview-screen,
.menu-home-mobile-demo-phone .mobile-menu-preview-frame {
  width: 390px !important;
  height: 844px !important;
}

.menu-home-mobile-demo-phone .mobile-menu-preview-frame {
  display: block;
  margin: 0;
  padding: 0;
  border: 0;
  transform: none !important;
  transform-origin: initial !important;
  background: #f5f7fb;
}

/* This is a real embedded demo, so language/category controls can
   still be tapped if the visitor wants to inspect the menu. */
.menu-home-mobile-demo-phone iframe {
  pointer-events: auto;
}

/* Keep the AIR-style expanding hover motion, but use BEYOND's
   soft blush accent instead of the blue gradient. */
.menu-home-secondary::before {
  background: #FFF7F7;
}

.menu-home-secondary:hover {
  color: #0d1b3a !important;
  box-shadow: 0 14px 30px rgba(70, 57, 76, 0.12);
}

@media (max-width: 900px) {

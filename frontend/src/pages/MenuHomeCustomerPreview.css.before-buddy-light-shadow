/* =========================================================
   MOBILE HEADLINE / BUDDY STACKING — CANONICAL
   BACK   : Create your / digital / menu
   MIDDLE : Buddy
   FRONT  : in minutes.
   ========================================================= */

@media (max-width: 820px) {

  .menu-home-hero-copy {
    position: relative !important;
    isolation: isolate !important;
  }

  /*
    The H1 and mobile wrapper are layout containers only.
    They must not become their own stacking layer.
  */
  .menu-home-hero-copy h1,
  .menu-home-title-mobile {
    position: static !important;
    z-index: auto !important;
    isolation: auto !important;
    transform: none !important;
    filter: none !important;
  }

  /*
    Undo the generic:
      .menu-home-hero h1 span
    rule for our mobile wrapper/layers.
  */
  .menu-home-title-mobile,
  .menu-home-title-mobile-back,
  .menu-home-title-mobile-front {
    background: none !important;
    background-image: none !important;
    -webkit-background-clip: border-box !important;
    background-clip: border-box !important;
  }

  /* BLACK TITLE — BEHIND BUDDY */
  .menu-home-title-mobile-back {
    display: block !important;
    position: relative !important;
    z-index: 1 !important;
    margin-top: 0 !important;
  }

  /*
    BUDDY — MIDDLE.
    IMPORTANT: no top/right/width/height/transform here,
    so your approved Buddy placement stays exactly unchanged.
  */
  .menu-home-hero-copy > .menu-home-buddy-mobile {
    z-index: 2 !important;
  }

  /* BLUE IN MINUTES — IN FRONT OF BUDDY */
  .menu-home-title-mobile-front {
    display: block !important;
    position: relative !important;
    z-index: 3 !important;
    margin-top: 8px !important;

    color: #4777ee !important;
    -webkit-text-fill-color: #4777ee !important;
  }
}




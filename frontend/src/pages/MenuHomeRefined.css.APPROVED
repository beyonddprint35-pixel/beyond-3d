

/* =========================================================
   BUDDY MASCOT — LOCAL TEST
   Only affects Buddy beside the homepage phone.
   ========================================================= */

.menu-home-phone-hero-visual {
  position: relative;
}

.menu-home-buddy-slot {
  position: absolute;

  left: -300px;
  bottom: 10px;

  width: 320px;
  height: 500px;

  z-index: 5;

  pointer-events: none;
}

.menu-home-buddy-slot .buddy-mascot {
  position: absolute !important;
  inset: 0 !important;

  width: 100% !important;
  height: 100% !important;

  opacity: 1 !important;
  transform: none !important;
  background: transparent !important;
}

.menu-home-buddy-slot canvas {
  width: 100% !important;
  height: 100% !important;
  display: block;
}

@media (max-width: 1100px) {
  .menu-home-buddy-slot {
    left: -220px;
    width: 260px;
    height: 420px;
  }
}

@media (max-width: 820px) {
  .menu-home-buddy-slot {
    display: none;
  }
}

/* BUDDY POSITION TUNING V2 */
.menu-home-buddy-slot {
  left: -155px !important;
  bottom: 0 !important;

  width: 270px !important;
  height: 455px !important;
}

/* BUDDY POSITION TUNING V3 */
.menu-home-buddy-slot {
  left: -40px !important;
  bottom: 0 !important;
}

/* BUDDY POSITION TUNING V4 */
.menu-home-buddy-slot {
  left: 20px !important;
}

/* BUDDY POSITION TUNING V5 */
.menu-home-buddy-slot {
  left: 95px !important;
}

/* BUDDY POSITION TUNING V6 */
.menu-home-buddy-slot {
  left: 140px !important;
}

/* BUDDY FINAL HORIZONTAL POSITION */
.menu-home-phone-hero-visual .menu-home-buddy-slot {
  transform: translateX(190px) !important;
}


/* =========================================================
   MOBILE BUDDY
   Sits beside the hero headline + description.
   Does not affect CTA buttons below.
   ========================================================= */

.menu-home-buddy-mobile {
  display: none;
}

@media (max-width: 820px) {

  .menu-home-hero-copy {
    position: relative;
  }

  .menu-home-buddy-mobile {
    display: block;

    position: absolute;

    right: -2px;
    top: 128px;

    width: 96px;
    height: 145px;

    margin: 0;

    z-index: 3;

    pointer-events: none;
  }

  .menu-home-buddy-mobile .buddy-mascot {
    position: absolute !important;

    inset: 0 !important;

    width: 100% !important;
    height: 100% !important;

    opacity: 1 !important;
    transform: none !important;

    background: transparent !important;
  }

  .menu-home-buddy-mobile canvas {
    width: 100% !important;
    height: 100% !important;

    display: block !important;
  }

  /*
    Reserve space only beside the text.
    Buttons below stay untouched/full width.
  */

  .menu-home-hero-copy h1 {
    padding-right: 82px;
  }

  .menu-home-hero-copy > p {
    padding-right: 92px;
  }
}

@media (max-width: 390px) {

  .menu-home-buddy-mobile {
    right: -4px;
    top: 132px;

    width: 86px;
    height: 132px;
  }

  .menu-home-hero-copy h1 {
    padding-right: 72px;
  }

  .menu-home-hero-copy > p {
    padding-right: 82px;
  }
}



/* === MOBILE BUDDY FINAL === */

.menu-home-buddy-mobile {
  display: none;
}

@media (max-width: 820px) {

  .menu-home-hero-copy {
    position: relative;
  }

  .menu-home-buddy-mobile {
    display: block !important;

    position: absolute !important;

    top: 175px;
    right: -4px;

    width: 105px;
    height: 155px;

    z-index: 10;

    margin: 0;
    padding: 0;

    pointer-events: none;
  }

  .menu-home-buddy-mobile .buddy-mascot {
    display: block !important;

    position: absolute !important;
    inset: 0 !important;

    width: 100% !important;
    height: 100% !important;

    opacity: 1 !important;
    visibility: visible !important;

    transform: none !important;
    background: transparent !important;
  }

  .menu-home-buddy-mobile canvas {
    display: block !important;

    width: 100% !important;
    height: 100% !important;
  }

  /* Give Buddy room beside the text only */
  .menu-home-hero-copy h1 {
    padding-right: 72px;
  }

  .menu-home-hero-copy > p {
    padding-right: 95px;
  }

  /* Buttons remain full width */
  .menu-home-hero-actions {
    position: relative;
    z-index: 20;
  }
}

@media (max-width: 390px) {

  .menu-home-buddy-mobile {
    top: 180px;
    right: -2px;

    width: 95px;
    height: 145px;
  }
}

/* =========================================================
   MOBILE BUDDY — MOBILE ONLY
   Never render this second Buddy on desktop.
   ========================================================= */

.menu-home-buddy-mobile {
  display: none !important;
}

@media (max-width: 820px) {
  .menu-home-buddy-mobile {
    display: block !important;
  }
}


/* =========================================================
   BUDDY RESPONSIVE SEPARATION — FINAL
   Desktop Buddy and Mobile Buddy are independent.
   ========================================================= */

/* DESKTOP */
@media (min-width: 821px) {

  /* Keep the original approved Buddy beside the phone */
  .menu-home-phone-hero-visual > .menu-home-buddy-slot {
    display: block !important;
  }

  /* Never show the mobile Buddy on desktop */
  .menu-home-hero-copy > .menu-home-buddy-mobile {
    display: none !important;
    visibility: hidden !important;
  }
}


/* MOBILE */
@media (max-width: 820px) {

  /* Never show the desktop Buddy on mobile */
  .menu-home-phone-hero-visual > .menu-home-buddy-slot {
    display: none !important;
    visibility: hidden !important;
  }

  /* Show only the dedicated mobile Buddy */
  .menu-home-hero-copy > .menu-home-buddy-mobile {
    display: block !important;
    visibility: visible !important;
  }
}


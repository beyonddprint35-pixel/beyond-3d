.admin-message,
.admin-error {
  padding: 30px;

  text-align: center;

  color: #8496b0;
}

.admin-error {
  color: #ff8d9b;
}

/* =========================
   ADMIN LOGIN
========================= */

.admin-login-page {
  min-height: 100vh;

  display: grid;
  place-items: center;

  padding: 25px;

  position: relative;
}

.admin-login-page::before {
  content: "";

  position: fixed;

  width: 450px;
  height: 450px;

  top: 10%;
  left: 50%;

  transform:
    translateX(-50%);

  border-radius: 50%;

  background:
    rgba(40, 112, 255, 0.14);

  filter:
    blur(120px);

  pointer-events: none;
}

.admin-login-card {
  width:
    min(
      440px,
      100%
    );

  padding: 38px;

  border-radius: 28px;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.06),
      rgba(255, 255, 255, 0.02)
    );

  box-shadow:
    0 40px 100px
    rgba(0, 0, 0, 0.3);

  backdrop-filter:
    blur(22px);

  position: relative;
  z-index: 2;
}

.admin-login-card h1 {
  margin:
    8px 0 12px;

  font-family:
    "Space Grotesk",
    sans-serif;

  font-size: 42px;

  letter-spacing: -2px;
}

.admin-login-card p {
  color: #8b9bb2;

  line-height: 1.6;
}

.admin-login-card form {
  display: grid;

  gap: 12px;

  margin-top: 28px;
}

.admin-login-card input {
  width: 100%;

  min-height: 52px;

  padding:
    0 15px;

  border-radius: 14px;

  border:
    1px solid
    rgba(255, 255, 255, 0.1);

  background:
    rgba(255, 255, 255, 0.035);

  color: white;

  outline: none;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.admin-login-card input:focus {
  border-color:
    rgba(81, 148, 255, 0.55);

  background:
    rgba(255, 255, 255, 0.05);

  box-shadow:
    0 0 0 4px
    rgba(36, 105, 255, 0.08);
}

/* =========================
   ORDER DETAILS
========================= */

.order-details-page {
  width:
    min(
      1180px,
      calc(100% - 40px)
    );

  margin: 0 auto;

  padding:
    30px 0 100px;
}

.order-details-topbar {
  min-height: 80px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 50px;
}

.order-back-button {
  padding:
    11px 16px;

  border-radius: 999px;

  border:
    1px solid
    rgba(255, 255, 255, 0.12);

  background:
    rgba(255, 255, 255, 0.035);

  font-size: 13px;

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.order-back-button:hover {
  background:
    rgba(255, 255, 255, 0.08);

  transform:
    translateY(-1px);
}

.order-details-heading {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 25px;

  margin-bottom: 28px;
}

.order-details-heading h1 {
  margin: 0;

  font-family:
    "Space Grotesk",
    sans-serif;

  font-size:
    clamp(
      42px,
      6vw,
      70px
    );

  letter-spacing: -4px;
}

.order-details-grid {
  display: grid;

  grid-template-columns:
    repeat(
      2,
      minmax(0, 1fr)
    );

  gap: 16px;
}

.order-detail-card {
  padding: 25px;

  border-radius: 22px;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.055),
      rgba(255, 255, 255, 0.02)
    );

  backdrop-filter:
    blur(18px);
}

.order-detail-card h2 {
  margin:
    0 0 22px;

  font-family:
    "Space Grotesk",
    sans-serif;

  font-size: 20px;
}

.order-info-grid {
  display: grid;

  grid-template-columns:
    repeat(
      2,
      minmax(0, 1fr)
    );

  gap: 20px;
}

.order-info-grid div {
  min-width: 0;
}

.order-info-grid span {
  display: block;

  margin-bottom: 7px;

  color: #71839e;

  font-size: 11px;

  text-transform:
    uppercase;

  letter-spacing: 1px;
}

.order-info-grid strong {
  display: block;

  color: #fff;

  font-size: 14px;

  line-height: 1.5;

  word-break: break-word;
}

.order-wide-card {
  grid-column:
    1 / -1;
}

.order-description {
  margin: 0;

  color: #98a7bc;

  line-height: 1.8;

  white-space:
    pre-wrap;
}

.order-file-box {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 20px;

  border-radius: 17px;

  background:
    rgba(10, 23, 43, 0.65);

  border:
    1px solid
    rgba(255, 255, 255, 0.07);
}

.order-file-box > div {
  min-width: 0;
}

.order-file-box strong {
  display: block;

  word-break: break-word;
}

.order-file-box span {
  display: block;

  margin-top: 6px;

  color: #7789a3;

  font-size: 12px;
}

.order-download-button {
  min-height: 44px;

  padding:
    0 17px;

  display:
    inline-flex;

  align-items: center;
  justify-content: center;

  white-space: nowrap;
}

.order-file-unavailable {
  color: #7586a0;
}

/* =========================
   ORDER STATUS CONTROLS
========================= */

.status-control-card {
  position: relative;
  overflow: hidden;
}

.status-control-card::after {
  content: "";

  position: absolute;

  width: 300px;
  height: 300px;

  right: -160px;
  top: -160px;

  border-radius: 50%;

  background:
    rgba(40, 112, 255, 0.08);

  filter:
    blur(60px);

  pointer-events: none;
}

.status-control-header {
  display: flex;

  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 25px;

  position: relative;
  z-index: 1;
}

.status-control-header h2 {
  margin:
    0 0 8px;
}

.status-control-header p {
  margin: 0;

  color: #8191a8;

  font-size: 13px;

  line-height: 1.6;
}

.status-buttons {
  display: grid;

  grid-template-columns:
    repeat(
      3,
      minmax(0, 1fr)
    );

  gap: 12px;

  position: relative;
  z-index: 1;
}

.status-step {
  min-height: 76px;

  padding:
    0 20px;

  display: flex;

  align-items: center;

  gap: 13px;

  border-radius: 16px;

  border:
    1px solid
    rgba(255, 255, 255, 0.09);

  background:
    rgba(255, 255, 255, 0.025);

  color: #a5b2c5;

  font-weight: 700;

  text-align: left;

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.status-step span {
  display: grid;

  place-items: center;

  width: 34px;
  height: 34px;

  flex:
    0 0 34px;

  border-radius: 50%;

  background:
    rgba(255, 255, 255, 0.05);

  color: #7588a5;

  font-size: 10px;
}

.status-step:hover:not(:disabled) {
  transform:
    translateY(-2px);

  border-color:
    rgba(65, 137, 255, 0.32);

  background:
    rgba(46, 112, 222, 0.07);
}

.status-step.active {
  border-color:
    rgba(60, 137, 255, 0.42);

  background:
    linear-gradient(
      135deg,
      rgba(23, 107, 255, 0.18),
      rgba(61, 135, 255, 0.08)
    );

  color: #ffffff;

  box-shadow:
    inset 0 0 30px
    rgba(39, 112, 255, 0.06);
}

.status-step.active span {
  background:
    #176bff;

  color:
    #ffffff;
}

.status-step:disabled {
  opacity: 0.55;
  cursor: wait;
}

/* =========================
   QUOTATION
========================= */

.quote-card {
  margin-top: 4px;
}

.quote-header {
  display: flex;

  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 28px;
}

.quote-header h2 {
  margin: 0;
}

.quote-status-badge {
  display: inline-flex;

  padding:
    8px 12px;

  border-radius: 999px;

  background:
    rgba(58, 126, 255, 0.12);

  border:
    1px solid
    rgba(86, 148, 255, 0.14);

  color: #79adff;

  font-size: 12px;
  font-weight: 700;
}

.quote-layout {
  display: grid;

  grid-template-columns:
    1.25fr
    0.75fr;

  gap: 20px;
}

.quote-form {
  display: grid;

  grid-template-columns:
    repeat(
      2,
      minmax(0, 1fr)
    );

  gap: 16px;
}

.quote-form label {
  display: flex;
  flex-direction: column;

  gap: 8px;
}

.quote-form label > span {
  color: #8192aa;

  font-size: 11px;

  text-transform:
    uppercase;

  letter-spacing: 1px;
}

.quote-input-wrap {
  position: relative;
}

.quote-input-wrap input {
  width: 100%;

  min-height: 52px;

  padding:
    0 70px 0 14px;

  border-radius: 14px;

  border:
    1px solid
    rgba(255, 255, 255, 0.09);

  outline: none;

  color: white;

  background:
    rgba(255, 255, 255, 0.035);

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.quote-input-wrap input:focus {
  border-color:
    rgba(81, 148, 255, 0.55);

  background:
    rgba(255, 255, 255, 0.05);

  box-shadow:
    0 0 0 4px
    rgba(36, 105, 255, 0.08);
}

.quote-input-wrap small {
  position: absolute;

  right: 14px;
  top: 50%;

  transform:
    translateY(-50%);

  color: #667993;

  font-size: 11px;

  pointer-events: none;
}

.quote-summary {
  padding: 22px;

  border-radius: 18px;

  border:
    1px solid
    rgba(255, 255, 255, 0.07);

  background:
    rgba(7, 18, 34, 0.62);
}

.quote-summary-row {
  display: flex;

  justify-content: space-between;

  gap: 20px;

  padding:
    11px 0;

  color: #91a1b8;

  font-size: 13px;
}

.quote-summary-row strong {
  color: #ffffff;
}

.quote-divider {
  height: 1px;

  margin:
    12px 0 18px;

  background:
    rgba(255, 255, 255, 0.08);
}

.quote-total {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 24px;
}

.quote-total span {
  color: #7e90aa;

  font-size: 11px;

  letter-spacing: 1.5px;
}

.quote-total strong {
  font-family:
    "Space Grotesk",
    sans-serif;

  font-size: 38px;

  letter-spacing: -1px;
}

.quote-actions {
  display: grid;

  grid-template-columns:
    1fr;

  gap: 10px;
}

.quote-save-button,
.quote-send-button {
  width: 100%;
}

.quote-send-button {
  min-height: 52px;
}

.quote-message {
  margin-top: 13px;

  padding: 12px;

  border-radius: 12px;

  text-align: center;

  color: #8cb8ff;

  background:
    rgba(44, 111, 222, 0.08);

  font-size: 13px;
}

/* =========================
   ANIMATIONS
========================= */

@keyframes modelFloat {
  0%,
  100% {
    transform:
      translateY(0);
  }

  50% {
    transform:
      translateY(-15px);
  }
}

@keyframes floatingCard {
  0%,
  100% {
    transform:
      translateY(0);
  }

  50% {
    transform:
      translateY(-12px);
  }
}

@keyframes rotateRing {
  from {
    transform:
      rotate(0deg);
  }

  to {
    transform:
      rotate(360deg);
  }
}


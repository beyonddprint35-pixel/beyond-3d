@import url(
  "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
);

:root {
  font-family: "Inter", sans-serif;
  color: #ffffff;
  background: #030712;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 80% 10%,
      rgba(24, 103, 255, 0.17),
      transparent 35%
    ),
    radial-gradient(
      circle at 10% 50%,
      rgba(19, 67, 150, 0.13),
      transparent 30%
    ),
    #030712;
}

button,
a,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

.site-shell {
  min-height: 100vh;
  overflow: hidden;
}

/* =========================
   NAVBAR
========================= */

.navbar {
  width: min(1240px, calc(100% - 40px));
  margin: 0 auto;
  height: 88px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  position: relative;
  z-index: 20;
}

.logo {
  font-family: "Space Grotesk", sans-serif;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 8px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 32px;

  color: rgba(255, 255, 255, 0.65);
  font-size: 14px;
}

.nav-links a {
  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.nav-links a:hover {
  color: #ffffff;
  transform: translateY(-1px);
}

.login-button {
  justify-self: end;

  border: 1px solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.04);
  color: white;

  padding: 11px 18px;
  border-radius: 999px;

  backdrop-filter: blur(14px);

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.login-button:hover {
  background: rgba(255, 255, 255, 0.09);
  transform: translateY(-1px);
}

/* =========================
   HERO
========================= */

.hero {
  width: min(1240px, calc(100% - 40px));
  margin: 0 auto;

  min-height: calc(100vh - 88px);

  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;

  gap: 70px;

  position: relative;

  padding: 50px 0 100px;
}

.hero-content {
  position: relative;
  z-index: 5;
}

.hero-badge {
  display: inline-flex;

  padding: 8px 13px;
  margin-bottom: 25px;

  border-radius: 999px;
  border: 1px solid rgba(86, 148, 255, 0.25);

  background: rgba(31, 93, 190, 0.08);

  color: #7fb0ff;

  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
}

.hero h1 {
  font-family: "Space Grotesk", sans-serif;

  margin: 0;
  max-width: 650px;

  font-size: clamp(58px, 7vw, 104px);

  line-height: 0.93;
  letter-spacing: -5px;
}

.hero h1 span {
  background:
    linear-gradient(
      90deg,
      #ffffff,
      #6ba9ff
    );

  -webkit-background-clip: text;
  background-clip: text;

  color: transparent;
}

.hero p {
  max-width: 600px;
  margin: 28px 0;

  color: #97a8c1;

  font-size: 18px;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 14px;

  margin-bottom: 45px;
}

.primary-button,
.secondary-button {
  min-height: 52px;

  padding: 0 22px;

  border-radius: 999px;

  font-weight: 700;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.primary-button {
  border: none;

  color: white;

  background:
    linear-gradient(
      135deg,
      #176bff,
      #3b82f6
    );

  box-shadow:
    0 12px 40px
    rgba(23, 107, 255, 0.32);
}

.primary-button:hover:not(:disabled) {
  transform: translateY(-2px);

  box-shadow:
    0 18px 50px
    rgba(23, 107, 255, 0.4);
}

.secondary-button {
  color: #ffffff;

  border:
    1px solid
    rgba(255, 255, 255, 0.13);

  background:
    rgba(255, 255, 255, 0.035);
}

.secondary-button:hover:not(:disabled) {
  background:
    rgba(255, 255, 255, 0.07);

  transform:
    translateY(-2px);
}

.primary-button:disabled,
.secondary-button:disabled {
  opacity: 0.6;
  cursor: wait;
}

.hero-stats {
  display: flex;
  gap: 35px;
}

.hero-stats div {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.hero-stats strong {
  font-size: 16px;
}

.hero-stats span {
  color: #7689a6;
  font-size: 12px;
}

/* =========================
   HERO VISUAL
========================= */

.hero-visual {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 600px;
}

.model-shell {
  width: 480px;
  height: 480px;

  position: relative;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(67, 141, 255, 0.13),
      transparent 63%
    );
}

.model-core {
  width: 330px;
  height: 330px;

  position: relative;

  display: grid;
  place-items: center;

  border-radius: 50%;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  background:
    radial-gradient(
      circle at 35% 25%,
      rgba(104, 169, 255, 0.18),
      transparent 35%
    ),
    rgba(255, 255, 255, 0.025);

  backdrop-filter:
    blur(20px);

  box-shadow:
    inset 0 0 70px
      rgba(71, 134, 255, 0.06),
    0 40px 100px
      rgba(0, 0, 0, 0.35);

  animation:
    modelFloat 6s ease-in-out infinite;
}

.model-object {
  width: 155px;
  height: 155px;

  display: grid;
  place-items: center;

  border-radius: 45px;

  font-family:
    "Space Grotesk",
    sans-serif;

  font-size: 92px;
  font-weight: 700;

  color: #e7f1ff;

  background:
    linear-gradient(
      145deg,
      #18263d,
      #07101e
    );

  border:
    1px solid
    rgba(122, 178, 255, 0.2);

  box-shadow:
    15px 25px 45px
      rgba(0, 0, 0, 0.45),
    inset 10px 10px 30px
      rgba(255, 255, 255, 0.04),
    0 0 70px
      rgba(34, 112, 255, 0.2);

  transform:
    perspective(900px)
    rotateX(13deg)
    rotateY(-16deg);
}

.model-ring {
  position: absolute;

  border-radius: 50%;

  border:
    1px solid
    rgba(85, 148, 255, 0.13);
}

.ring-one {
  inset: -45px;

  animation:
    rotateRing 17s linear infinite;
}

.ring-two {
  inset: -90px;

  border-style: dashed;

  animation:
    rotateRing 26s linear infinite reverse;
}

.floating-card {
  position: absolute;

  min-width: 145px;

  padding: 15px 17px;

  border-radius: 16px;

  border:
    1px solid
    rgba(255, 255, 255, 0.09);

  background:
    rgba(8, 18, 34, 0.7);

  backdrop-filter:
    blur(18px);

  box-shadow:
    0 18px 50px
    rgba(0, 0, 0, 0.25);

  display: flex;
  flex-direction: column;
  gap: 5px;
}

.floating-card span {
  color: #7287a6;
  font-size: 10px;
  letter-spacing: 1.2px;
}

.floating-card strong {
  font-size: 14px;
}

.floating-card-one {
  top: 90px;
  right: 0;

  animation:
    floatingCard 5s ease-in-out infinite;
}

.floating-card-two {
  bottom: 100px;
  left: -25px;

  animation:
    floatingCard 6s ease-in-out infinite reverse;
}

/* =========================
   HERO GLOWS
========================= */

.hero-glow {
  position: absolute;

  border-radius: 50%;

  filter: blur(100px);

  pointer-events: none;
}

.hero-glow-one {
  width: 360px;
  height: 360px;

  right: -70px;
  top: 50px;

  background:
    rgba(32, 108, 255, 0.16);
}

.hero-glow-two {
  width: 280px;
  height: 280px;

  left: 10%;
  bottom: 0;

  background:
    rgba(38, 80, 180, 0.1);
}

/* =========================
   HOW IT WORKS
========================= */

.how-section {
  width:
    min(
      1240px,
      calc(100% - 40px)
    );

  margin: 0 auto;

  padding:
    110px 0 130px;

  position: relative;
}

.section-heading {
  max-width: 760px;
  margin-bottom: 55px;
}

.section-kicker {
  margin-bottom: 16px;

  color: #71a5ff;

  font-size: 11px;
  font-weight: 700;

  letter-spacing: 2.5px;
}

.section-heading h2 {
  margin: 0;

  font-family:
    "Space Grotesk",
    sans-serif;

  font-size:
    clamp(
      42px,
      6vw,
      74px
    );

  line-height: 1;

  letter-spacing: -3px;
}

.section-heading h2 span {
  color: #7587a3;
}

.section-heading p {
  max-width: 620px;

  margin:
    24px 0 0;

  color: #91a1b9;

  font-size: 17px;

  line-height: 1.7;
}

.steps-grid {
  display: grid;

  grid-template-columns:
    repeat(
      4,
      minmax(0, 1fr)
    );

  gap: 16px;
}

.step-card {
  min-height: 300px;

  padding: 25px;

  border-radius: 24px;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.055),
      rgba(255, 255, 255, 0.02)
    );

  backdrop-filter:
    blur(18px);

  position: relative;

  overflow: hidden;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}

.step-card::after {
  content: "";

  position: absolute;

  width: 160px;
  height: 160px;

  right: -70px;
  bottom: -70px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(53, 125, 255, 0.16),
      transparent 70%
    );
}

.step-card:hover {
  transform:
    translateY(-8px);

  border-color:
    rgba(89, 153, 255, 0.25);

  box-shadow:
    0 30px 70px
    rgba(0, 0, 0, 0.2);
}

.step-number {
  color: #6fa8ff;

  font-size: 12px;
  font-weight: 700;

  letter-spacing: 1.5px;
}

.step-line {
  width: 42px;
  height: 1px;

  margin:
    22px 0 55px;

  background:
    linear-gradient(
      90deg,
      #4c96ff,
      transparent
    );
}

.step-card h3 {
  margin:
    0 0 14px;

  font-family:
    "Space Grotesk",
    sans-serif;

  font-size: 28px;
}

.step-card p {
  margin: 0;

  color: #899ab3;

  font-size: 14px;

  line-height: 1.7;
}

/* =========================
   UPLOAD PROJECT
========================= */

.upload-section {
  width:
    min(
      1240px,
      calc(100% - 40px)
    );

  margin: 0 auto;

  padding:
    100px 0 140px;
}

.upload-heading {
  max-width: 760px;
  margin-bottom: 55px;
}

.upload-heading h2 {
  margin: 0;

  font-family:
    "Space Grotesk",
    sans-serif;

  font-size:
    clamp(
      42px,
      6vw,
      74px
    );

  line-height: 1;

  letter-spacing: -3px;
}

.upload-heading h2 span {
  color: #7385a0;
}

.upload-heading p {
  max-width: 620px;

  margin-top: 23px;

  color: #91a1b9;

  line-height: 1.7;

  font-size: 17px;
}

.upload-layout {
  display: grid;

  grid-template-columns:
    0.8fr 1.2fr;

  gap: 18px;

  align-items: stretch;
}

.upload-visual,
.project-form {
  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  border-radius: 28px;

  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.055),
      rgba(255, 255, 255, 0.02)
    );

  backdrop-filter:
    blur(20px);
}

.upload-visual {
  min-height: 620px;

  padding: 40px;

  position: relative;

  overflow: hidden;

  display: flex;

  flex-direction: column;

  justify-content: flex-end;
}

.upload-visual-glow {
  position: absolute;

  width: 400px;
  height: 400px;

  top: -130px;
  left: -130px;

  border-radius: 50%;

  background:
    rgba(36, 111, 255, 0.18);

  filter:
    blur(80px);
}

.upload-icon {
  position: relative;

  width: 94px;
  height: 94px;

  margin-bottom: auto;

  display: grid;
  place-items: center;

  border-radius: 28px;

  font-size: 43px;

  color: #8ab8ff;

  background:
    linear-gradient(
      145deg,
      rgba(39, 108, 230, 0.24),
      rgba(255, 255, 255, 0.03)
    );

  border:
    1px solid
    rgba(116, 174, 255, 0.18);

  box-shadow:
    0 30px 80px
    rgba(16, 88, 220, 0.18);
}

.upload-visual h3 {
  position: relative;

  margin:
    0 0 12px;

  font-family:
    "Space Grotesk",
    sans-serif;

  font-size: 35px;
}

.upload-visual p {
  position: relative;

  max-width: 380px;

  margin:
    0 0 30px;

  color: #8fa0b9;

  font-size: 15px;

  line-height: 1.7;
}

.upload-benefits {
  position: relative;

  display: flex;

  flex-direction: column;

  gap: 12px;

  color: #b9c5d6;

  font-size: 14px;
}

.project-form {
  padding: 32px;
}

.form-grid {
  display: grid;

  grid-template-columns:
    repeat(
      2,
      minmax(0, 1fr)
    );

  gap: 18px;
}

.project-form label {
  display: flex;

  flex-direction: column;

  gap: 9px;
}

.project-form label > span {
  color: #8ea0bb;

  font-size: 12px;

  font-weight: 600;
}

.project-form input,
.project-form select,
.project-form textarea {
  width: 100%;

  border:
    1px solid
    rgba(255, 255, 255, 0.09);

  outline: none;

  border-radius: 14px;

  background:
    rgba(255, 255, 255, 0.035);

  color: #ffffff;

  padding:
    14px 15px;

  transition:
    border-color 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.project-form select option {
  background: #0a1220;
  color: white;
}

.project-form textarea {
  resize: vertical;
  min-height: 130px;
}

.project-form input:focus,
.project-form select:focus,
.project-form textarea:focus {
  border-color:
    rgba(81, 148, 255, 0.55);

  background:
    rgba(255, 255, 255, 0.05);

  box-shadow:
    0 0 0 4px
    rgba(36, 105, 255, 0.08);
}

.full-field {
  margin-top: 18px;
}

.drop-zone {
  margin-top: 22px;

  min-height: 180px;

  border:
    1px dashed
    rgba(116, 157, 218, 0.3);

  border-radius: 20px;

  background:
    rgba(29, 81, 167, 0.045);

  transition:
    border-color 0.2s ease,
    background 0.2s ease;
}

.drop-zone:hover,
.drop-zone.has-file {
  border-color:
    rgba(82, 150, 255, 0.6);

  background:
    rgba(37, 108, 226, 0.08);
}

.drop-zone-content {
  min-height: 180px;

  display: flex !important;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  text-align: center;

  cursor: pointer;
}

.drop-icon {
  width: 46px;
  height: 46px;

  display: grid;
  place-items: center;

  margin-bottom: 12px;

  border-radius: 14px;

  color: #82b2ff;

  font-size: 25px;

  background:
    rgba(53, 120, 232, 0.12);
}

.drop-zone-content strong {
  font-size: 15px;
}

.drop-zone-content span {
  margin-top: 6px;

  color: #8395af;

  font-size: 13px;
}

.drop-zone-content small {
  margin-top: 9px;

  color: #60738e;
}

.submit-project-button {
  width: 100%;

  min-height: 55px;

  margin-top: 22px;

  border: none;

  border-radius: 16px;

  color: #ffffff;

  font-weight: 700;

  background:
    linear-gradient(
      135deg,
      #176bff,
      #438aff
    );

  box-shadow:
    0 15px 45px
    rgba(23, 107, 255, 0.25);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.submit-project-button:hover:not(
  :disabled
) {
  transform:
    translateY(-2px);

  box-shadow:
    0 20px 55px
    rgba(23, 107, 255, 0.33);
}

.submit-project-button:disabled {
  cursor: wait;
  opacity: 0.65;
}

.form-status {
  margin-top: 16px;

  padding: 14px;

  text-align: center;

  border-radius: 14px;

  background:
    rgba(44, 111, 222, 0.09);

  color: #8cb8ff;

  font-size: 14px;
}

/* =========================
   CONTACT
========================= */

.contact-section {
  width:
    min(
      1240px,
      calc(100% - 40px)
    );

  margin: 0 auto;

  padding:
    120px 0 150px;

  text-align: center;
}

.contact-section h2 {
  max-width: 850px;

  margin: 0 auto;

  font-family:
    "Space Grotesk",
    sans-serif;

  font-size:
    clamp(
      44px,
      6vw,
      78px
    );

  line-height: 1;

  letter-spacing: -3px;
}

.contact-section h2 span {
  color: #7486a1;
}

.contact-section p {
  max-width: 560px;

  margin:
    25px auto 30px;

  color: #91a1b9;

  font-size: 17px;

  line-height: 1.7;
}

.contact-button {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 52px;
}

/* =========================
   REACT ADMIN
========================= */

.admin-page {
  width:
    min(
      1240px,
      calc(100% - 40px)
    );

  margin: 0 auto;

  padding:
    30px 0 100px;
}

.admin-topbar {
  min-height: 80px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 55px;
}

.admin-topbar > div {
  display: flex;
  align-items: center;
  gap: 20px;
}

.admin-topbar span {
  color: #8294ae;
  font-size: 13px;
}

.admin-logout-button {
  padding:
    11px 17px;

  border-radius: 999px;

  border:
    1px solid
    rgba(255, 255, 255, 0.12);

  color: white;

  background:
    rgba(255, 255, 255, 0.035);

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.admin-logout-button:hover {
  background:
    rgba(255, 255, 255, 0.08);

  transform:
    translateY(-1px);
}

.admin-heading {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 25px;

  margin-bottom: 35px;
}

.admin-heading h1 {
  margin: 0;

  font-family:
    "Space Grotesk",
    sans-serif;

  font-size:
    clamp(
      46px,
      6vw,
      78px
    );

  letter-spacing: -4px;
}

.admin-heading p {
  color: #8d9db5;

  margin:
    14px 0 0;

  font-size: 16px;
}

.admin-stats {
  display: grid;

  grid-template-columns:
    repeat(
      4,
      minmax(0, 1fr)
    );

  gap: 14px;

  margin-bottom: 28px;
}

.admin-stats article {
  padding: 23px;

  border-radius: 20px;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.055),
      rgba(255, 255, 255, 0.02)
    );

  backdrop-filter:
    blur(18px);
}

.admin-stats span {
  display: block;

  color: #71849f;

  font-size: 12px;

  margin-bottom: 10px;
}

.admin-stats strong {
  font-size: 29px;
}

.admin-orders {
  display: grid;
  gap: 12px;
}

.admin-order-card {
  display: grid;

  grid-template-columns:
    1.6fr
    1fr
    0.5fr
    0.8fr
    auto;

  gap: 18px;

  align-items: center;

  padding: 20px;

  border-radius: 19px;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  background:
    rgba(255, 255, 255, 0.025);

  transition:
    border-color 0.2s ease,
    transform 0.2s ease,
    background 0.2s ease;
}

.admin-order-card:hover {
  transform:
    translateY(-2px);

  border-color:
    rgba(85, 149, 255, 0.26);

  background:
    rgba(255, 255, 255, 0.035);
}

.admin-order-number {
  display: block;

  color: #73aaff;

  font-size: 12px;

  font-weight: 700;

  margin-bottom: 7px;
}

.admin-order-card h3 {
  margin: 0;

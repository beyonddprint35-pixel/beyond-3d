    5px 0 0;

  color: #7f91aa;

  font-size: 13px;
}

.admin-label {
  display: block;

  color: #657994;

  font-size: 10px;

  letter-spacing: 1px;

  margin-bottom: 7px;
}

.admin-status {
  display: inline-flex;

  padding:
    7px 11px;

  border-radius: 999px;

  background:
    rgba(47, 125, 255, 0.13);

  color: #79aeff;

  font-size: 12px;

  font-weight: 700;
}

.admin-view-button {
  padding:
    10px 14px;

  border-radius: 12px;

  border:
    1px solid

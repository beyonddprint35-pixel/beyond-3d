{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Beyond: Start Menu Studio",
      "type": "shell",
      "command": "fuser -k 5174/tcp 2>/dev/null || true; npm run dev -- --host 0.0.0.0 --port 5174",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "close": false,
        "showReuseMessage": false
      }
    }
  ]
}
